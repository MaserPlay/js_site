<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

<style>
  #debug {
    position: fixed;
    top: 5rem;
    right: 1rem;
    width: 290px;
    max-width: calc(100vw - 2rem);
    z-index: 100;
  }

  #debug>summary {
    cursor: pointer;
    user-select: none;
  }

  #debug>.card-body {
    max-height: calc(100dvh - 10rem);
    overflow-y: auto;
  }
</style>

<canvas id="canvas" aria-label="<%= __(" City: 3D city") %>"></canvas>

<details id="debug" class="card shadow" open>
  <summary class="card-header fw-semibold">
    Debugging
  </summary>

  <div class="card-body d-grid gap-3">
    <section>
      <dl class="row small mb-0">
        <dt class="col-7">FPS</dt>
        <dd id="debug-fps" class="col-5 text-end">—</dd>
      </dl>
    </section>
    <section>
      <dl class="row small mb-0">
        <dt class="col-7">Скорость симуляции</dt>
        <dd class="col-5 text-end">
          <input id="simulation-speed" class="form-range flex-grow-1" type="range" min="0.5" max="3" step="0.1"
            value="1">

          <output for="simulation-speed" class="text-nowrap" style="min-width: 3rem">1×</output>
        </dd>
      </dl>
    </section>
    <section>
      <dl class="row small mb-0">
        <dt class="col-7">Starting vehicles count</dt>
        <dd class="col-5 text-end">
          <input id="starting-vehicles-count" class="form-range flex-grow-1" type="range" min="2" max="90" step="1"
            value="10">

          <output for="starting-vehicles-count" class="text-nowrap" style="min-width: 3rem">--</output>
        </dd>
      </dl>
    </section>
    <section>
      <dl class="row small mb-0">
        <dt class="col-7">Debug markers</dt>
        <dd class="col-5 text-end">
          <input id="debug-labels" class="form-check-input"
                type="checkbox" checked>
        </dd>
      </dl>
    </section>
    <button id="simulation-pause" type="button" class="btn btn-outline-secondary btn-sm">
      Пауза симуляции
    </button>
  </div>
</details>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.186.1/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.186.1/examples/jsm/"
  }
}
</script>
<script type="module" src="<%= js_module_include('index') %>"></script>