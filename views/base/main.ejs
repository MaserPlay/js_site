<% if (!styleOfPage)
{
    var styleOfPage = pageStyle().Standart
}%>
<!DOCTYPE html>
<html lang='<%= getLocale() %>' data-bs-theme='<%= theme() %>' <%= event() ? `data-bs-event-theme='${event()}'` : ""%>> 
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="MaserPlay">
    <title><%= name %> - JS MaserPlay's Projects</title>
    <meta name="description" content="<%= description %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="<%= css_include('https://maserplay.ru/css/site') %>" rel="stylesheet" />
    <link rel="stylesheet" href="<%= css_include('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons') %>">
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= name %> - JS MaserPlay's Projects" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="/favicon.ico" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <% if (true) { %>
        <!-- Yandex.Metrika counter -->
        <script async type="text/javascript" >
            (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
            (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        
            ym(97253488, "init", {
                clickmap:true,
                trackLinks:true,
                accurateTrackBounce:true
            });
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/97253488" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
        <!-- /Yandex.Metrika counter -->
    <% } %>
	<link rel="stylesheet" href="/index.css">
    <% if (eventGoingSnow()) { %>
        <link rel="stylesheet" href="/snow.css">
    <% } %>
    <%- style %>
    <% if (styleOfPage == pageStyle().Fullscreen) { %>
        <style>
            footer {
                bottom: 0 !important;
                position: fixed !important;
                width: 100% !important;
                backdrop-filter: blur(3px);
                transition: transform 0.5s ease-in-out;
                transform: translateY(90%);
                z-index: 999;
            }
            footer:hover {
                transform: translateY(0%);
            }
            header {
                backdrop-filter: blur(2px);
                position: fixed !important;
                z-index: 999;
            }
            .right_panel{
                background-color: rgba(var(--bs-body-bg), 25);
                font-size: 1.5rem; 
                padding: 10px 30px; 
                top: 0px;
                right: 0px;
                transform: translateX(90%);
                transition: transform 0.5s ease-in-out;
            }
            .right_panel:hover{
                transform: translateX(0%);
            }
            @media (max-width: 768px) {
                .right_panel{
                    transform: unset;
                }
            }
        </style>
    <% } %>
    <%- meta %>
</head>

<body class="d-flex flex-column min-vh-100">
    <%- include(pageLayout.template, { body }) %>
</body>
        
<script defer src="<%= js_include('https://code.jquery.com/jquery-3.7.1') %>"></script>
<script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script defer src="<%= js_include('/index') %>"></script>
<script defer src="<%= js_include('index') %>"></script>
<%- script %>

</html>
